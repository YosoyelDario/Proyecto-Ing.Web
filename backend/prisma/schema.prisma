// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// LO DE AQUI SON LAS TABLAS

// 1. Catálogo de Áreas Médicas
model Especialidad {
  id           Int          @id @default(autoincrement())
  nombre       String       @db.VarChar(64)
  profesionales Profesional[]

  @@map("especialidad")
}

// 2. Médicos (Tabla profesional)
model Profesional {
  id             Int                  @id @default(autoincrement())
  rut            String               @unique @db.VarChar(12) // Formato único con guion
  nombre         String               @db.VarChar(64)
  idEspecialidad Int                  @map("id_especialidad")
  especialidad   Especialidad         @relation(fields: [idEspecialidad], references: [id])
  diasLaborales  DiaLaboral[]
  excepciones    ExcepcionDiaLaboral[]
  citas          Cita[]

  @@map("profesional")
}

// 3. Agenda Semanal Recurrente
model DiaLaboral {
  id            Int         @id @default(autoincrement())
  idMedico      Int         @map("id_medico")
  profesional   Profesional @relation(fields: [idMedico], references: [id])
  diaSemana     Int         @db.SmallInt // 0=Lunes, 1=Martes, etc.
  horaInicio    DateTime    @db.Time
  horaFin       DateTime    @db.Time
  duracionHora  DateTime    @db.Time

  @@map("dia_laboral")
}

// 4. Excepciones puntuales (Feriados, Licencias)
model ExcepcionDiaLaboral {
  id               Int         @id @default(autoincrement())
  idMedico         Int         @map("id_medico")
  profesional      Profesional @relation(fields: [idMedico], references: [id])
  fecha            DateTime    @db.Date
  horaInicio       DateTime    @db.Time
  horaFin          DateTime    @db.Time
  duracionAtencion Int         @db.SmallInt
  tipo             String      @db.VarChar(16) // "Licencia", "Feriado"
  motivo           String?     @db.VarChar(128)

  @@map("excepcion_dia_laboral")
}

// 5. Cuentas de Pacientes y Administradores
model Usuario {
  id             Int          @id @default(autoincrement())
  rut            String       @unique @db.VarChar(12) // RUT como índice único para búsquedas rápidas
  nombreCompleto String       @db.VarChar(64)
  email          String       @unique @db.VarChar(128)
  passwordHash   String       @db.VarChar(60) // Cambiado a String para almacenar hashes de bcrypt directo
  region         String?      @db.VarChar(64)
  comuna         String       @db.VarChar(64)
  isAdmin        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamp
  updatedAt      DateTime     @updatedAt @db.Timestamp
  citas          Cita[]
  cambios        CambiosCita[]

  @@map("usuario")
}

// 6. Entidad de Citas Médicas
model Cita {
  id               Int          @id @default(autoincrement())
  codigoReferencia String       @unique @db.VarChar(9) // Formato YYMMDDCCC
  idPaciente       Int?         @map("id_paciente")    // Nullable para agendar sin cuenta
  usuario          Usuario?     @relation(fields: [idPaciente], references: [id])
  idMedico         Int          @map("id_medico")
  profesional      Profesional  @relation(fields: [idMedico], references: [id])
  fecha            DateTime     @db.Date
  hora             DateTime     @db.Time
  estado           String       @default("Agendada") @db.VarChar(16) // Agendada, Completada, Cancelada, No asiste
  createdAt        DateTime     @default(now()) @db.Timestamp
  updatedAt        DateTime     @updatedAt @db.Timestamp
  
  cambios          CambiosCita[]
  notificaciones   Notificacion[]

  @@map("cita")
}

// 7. Trazabilidad e Historial de Auditoría
model CambiosCita {
  id         Int      @id @default(autoincrement())
  idCita     Int      @map("id_cita")
  cita       Cita     @relation(fields: [idCita], references: [id], onDelete: Cascade)
  idUsuario  Int?     @map("id_usuario") // Quién ejecutó el cambio (Admin o Paciente)
  usuario    Usuario? @relation(fields: [idUsuario], references: [id])
  accion     String   @db.VarChar(16) // "Creacion", "Modificacion", "Cancelacion"
  cambios    Json     // Formato JSON nativo de PostgreSQL para auditoría flexible
  createdAt  DateTime @default(now()) @db.Timestamp

  @@map("cambios_cita")
}

// 8. Registro de Notificaciones Informativas
model Notificacion {
  id         Int      @id @default(autoincrement())
  idCita     Int      @map("id_cita")
  cita       Cita     @relation(fields: [idCita], references: [id], onDelete: Cascade)
  motivo     String   @db.VarChar(16) // Confirmacion, Cancelacion
  mensaje    String   @db.Text
  estado     String   @db.VarChar(16) // Enviado, Fallido

  @@map("notificacion")
}